# This repository has two applications. Copy each section into the indicated
# file; do not use this combined root file as an application environment file.

# -----------------------------------------------------------------------------
# apps/api/.env (local) / Railway environment variables (production)
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://?retryWrites=true&w=majority
# Use a cryptographically random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=4000

# -----------------------------------------------------------------------------
# apps/web/.env.local (local) / Vercel environment variable (production)
# -----------------------------------------------------------------------------
# Server-only origin used by Next.js to proxy same-origin /api requests.
# Do not prefix this variable with NEXT_PUBLIC_.
API_ORIGIN=http://localhost:4000
